# Cloudflare Pages headers (sintaxe igual ao Netlify _headers)

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# "immutable" só onde o nome do arquivo tem hash (/_astro/*). Arquivo de public/ sem hash (clearix-attrib.js) com
# cache curto: com 1 ano de immutable, o script novo de 15/09 não chegava a quem já tinha o antigo, nem na borda.
/clearix-attrib.js
  Cache-Control: public, max-age=300, must-revalidate

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/llms.txt
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600

/llms-full.txt
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600
