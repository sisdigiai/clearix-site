---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Rotulo from '../components/Rotulo.astro';
import { apps, jornadas } from '../data/apps';
import { CTA, medidoEm, jornadaOS, provaBanco, pacientesReceitas, faq, retornoReceita, retornoProximos, retornoNota, capturaQuemChamar } from '../data/landing';
import { planos } from '../data/planos';
import { linkWhatsapp } from '../data/contato';

// Copy aprovada: _COPY_2026-09-14_LANDING.md (eco + revisão do Geral). Todo número vem de src/data/landing.ts.
const whats = linkWhatsapp('site');

const dores = [
  { dor: 'O cliente liga para perguntar se o óculos chegou, e ninguém sabe responder sem ligar para o laboratório.', resposta: 'Cada OS aparece por etapa, com alerta quando atrasa.' },
  { dor: 'O óculos saiu com saldo em aberto e ninguém percebeu.', resposta: 'A entrega não passa enquanto houver saldo sem carnê.' },
  { dor: 'O carnê mora num caderno e a parcela paga não foi baixada.', resposta: 'Carnê próprio da loja, com baixa e recibo na hora.' },
  { dor: 'O caixa fecha em planilha, não bate com o banco, e o dono só descobre no fim do mês.', resposta: 'Caixa conferido, extrato conciliado e o painel do dono mostrando o dia.' },
];

const cadeiaSolta = ['Venda no balcão', 'Baixa no estoque', 'Pedido ao laboratório', 'Lançamento no financeiro'];

const textosPasso: Record<string, string> = {
  Receita: 'A venda começa pelo grau. O sistema filtra as lentes que servem para aquela receita e barra combinação impossível antes de fechar.',
  Venda: 'À vista ou no carnê, no mesmo fluxo, com contrato e promissória gerados na hora.',
  Laboratório: 'Antes de comprar a lente, veja preço e prazo lado a lado entre os laboratórios. A escolha é sua. A OS segue para o laboratório pelo WhatsApp.',
  Acompanhamento: 'Kanban por etapa, linha do tempo de cada pedido e alerta de atraso. O atraso aparece na tela antes de virar ligação do cliente.',
  Entrega: 'Só sai quitada ou com carnê. Garantia e segundo par ficam ligados à OS original.',
  Fechamento: 'Parcela baixada, caixa conferido e comissão calculada da venda entregue, não de planilha.',
};

const receitas = pacientesReceitas[0];
const crescimento = planos.find((p) => p.slug === 'crescimento')!;

const fases = [
  { t: 'Demonstração assistida', d: 'Vinte minutos, com a gente na tela: da receita à entrega, no fluxo que a sua loja já tem.' },
  { t: 'Olhar o seu processo', d: 'Antes de propor qualquer coisa, entendemos como a sua loja trabalha hoje.' },
  { t: 'Piloto pago e assistido', d: 'Implantamos com a gente acompanhando. O que você usar define o que fica.' },
];
---

<BaseLayout
  title="Clearix — sistema para óticas, de orçamento a entrega"
  description="Venda, carnê, laboratório, WhatsApp e financeiro da ótica no mesmo sistema, o mesmo que roda hoje no balcão de uma ótica de verdade. Agende 20 minutos de demonstração."
>
  <!-- S1 · Hero -->
  <section data-lux class="lux-cyan relative overflow-hidden grid-bg pt-32 pb-10 md:pt-36 md:pb-12">
    <div class="lux-glow"></div>
    <div class="pointer-events-none absolute -right-40 top-10 hidden h-[560px] w-[560px] text-clearix-cyan-bright opacity-40 lg:block" aria-hidden="true">
      <svg viewBox="0 0 200 200" fill="none" class="h-full w-full">
        <g class="lens-ccw" style="transform-origin:100px 100px">
          <circle cx="100" cy="100" r="82" stroke="currentColor" stroke-width="0.5" stroke-opacity="0.5" stroke-dasharray="3 7" />
          <circle cx="100" cy="100" r="66" stroke="currentColor" stroke-width="1.4" stroke-dasharray="48 170" stroke-opacity="0.8" />
        </g>
        <circle cx="100" cy="100" r="48" stroke="currentColor" stroke-width="0.6" stroke-opacity="0.35" />
        <circle cx="100" cy="100" r="3" fill="currentColor" />
      </svg>
    </div>

    <div class="container-grid relative z-10 max-w-4xl lg:max-w-container">
      <div class={retornoReceita ? 'grid items-center gap-10 lg:grid-cols-[1.1fr_.9fr] lg:gap-14' : ''}>
      <div class="max-w-3xl anim-fade-in">
        <p class="label mb-6">Sistema para óticas · feito dentro de uma ótica</p>
        <h1 class="h-display mb-6">Quantos clientes compraram de você e <span class="text-clearix-cyan-bright italic">nunca mais voltaram</span>?</h1>
        <p class="body-lg mb-9 max-w-2xl">
          Receita vencida, cliente que sumiu, orçamento que ninguém retomou. O Clearix mostra, todo dia, quem chamar de
          volta, sem repetir quem já foi chamado. E é o mesmo sistema que cuida da venda, do carnê, do laboratório e do
          WhatsApp da loja.
        </p>
        <a href="/contato" class="btn-primary cta-pulse" data-cta="hero">{CTA}</a>
        {whats && (
          <p class="mt-4 text-body-md text-clarity-muted">
            ou <a href={whats} target="_blank" rel="noopener" class="inline-block py-2 text-clearix-cyan-bright underline underline-offset-4" data-cta="hero_whatsapp">fale com a gente no WhatsApp →</a>
          </p>
        )}
      </div>

      {retornoReceita && (
        <div class="card">
          <p class="label-sm mb-4">Na base de uma ótica real</p>
          <p class="font-mono text-[44px] leading-none tabular-nums text-clarity-off">{retornoReceita.valor}</p>
          <p class="mt-4 text-body-md text-clarity-dim">{retornoReceita.label}</p>
          <p class="mt-4 text-[13px] text-clarity-muted">Medido em {retornoReceita.data}, numa rede de óticas da casa. Sem dado pessoal. {retornoNota}</p>
        </div>
      )}
      </div>

      <figure class="shot mt-12 max-w-5xl">
        <picture class="block">
          <source srcset="/capturas/dcl-kanban-atraso_desfocado-800.avif 800w, /capturas/dcl-kanban-atraso_desfocado.avif 1600w" sizes="(min-width: 1024px) 1024px, 100vw" type="image/avif" />
          <source srcset="/capturas/dcl-kanban-atraso_desfocado-800.webp 800w, /capturas/dcl-kanban-atraso_desfocado.webp 1600w" sizes="(min-width: 1024px) 1024px, 100vw" type="image/webp" />
          <img src="/capturas/dcl-kanban-atraso_desfocado.png" width="1600" height="553" decoding="async" fetchpriority="high"
          alt="Kanban de laboratório com colunas por etapa e um pedido marcado como vencido com 16 dias de atraso" class="block h-auto w-full" />
        </picture>
        <figcaption class="p-5 text-body-md text-clarity-muted">Tela real de uma rede de óticas da Grande São Paulo, com dados de cliente, OS, valores e usuário desfocados. O pedido atrasado aparece na etapa, com os dias de atraso no cartão.</figcaption>
      </figure>
    </div>
  </section>

  {/* Quem chamar hoje — mock B (24/09). Folha §2: lista diária sem repetir quem já foi chamado; NÃO: campanha com IA, disparo em massa, recall por IA. Módulo do plano Crescimento (banco). */}
  <section id="quem-chamar" class="py-20 md:py-28 bg-ink-deep border-b border-clarity-off/10">
    <div class="container-grid grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
      <div>
        <p class="label mb-4">Quem chamar hoje</p>
        <h2 class="h-section mb-5">Uma lista por dia, sem repetir quem já foi chamado.</h2>
        <p class="body-lg mb-4">Lista diária de clientes para retomar contato, sem repetir quem já foi chamado. É uma lista para a sua equipe agir: sem disparo em massa e sem recall por IA.</p>
        {retornoProximos && (
          <p class="mb-4 border-l-2 border-clearix-cyan-bright pl-4 text-body-lg text-clarity-off">
            <span class="font-mono tabular-nums">{retornoProximos.valor}</span> {retornoProximos.label}
            <span class="mt-1 block text-[13px] text-clarity-muted">Medido em {retornoProximos.data}, numa rede de óticas da casa.</span>
          </p>
        )}
        <p class="mb-8 text-body-md text-clarity-muted">Módulo do plano {crescimento.nome} ({crescimento.preco}{crescimento.precoNota}), junto do painel do dono.</p>
        <a href="/contato" class="btn-primary" data-cta="quem_chamar">{CTA}</a>
      </div>

      {capturaQuemChamar ? (
        <figure class="shot reveal">
          <picture class="block">
            <source srcset={`/capturas/${capturaQuemChamar.arquivo}-800.avif 800w, /capturas/${capturaQuemChamar.arquivo}.avif ${capturaQuemChamar.w}w`} sizes="(min-width: 1024px) 50vw, 100vw" type="image/avif" />
            <source srcset={`/capturas/${capturaQuemChamar.arquivo}-800.webp 800w, /capturas/${capturaQuemChamar.arquivo}.webp ${capturaQuemChamar.w}w`} sizes="(min-width: 1024px) 50vw, 100vw" type="image/webp" />
            <img src={`/capturas/${capturaQuemChamar.arquivo}.png`} width={capturaQuemChamar.w} height={capturaQuemChamar.h} loading="lazy" decoding="async" alt={capturaQuemChamar.alt} class="block h-auto w-full" />
          </picture>
          <figcaption class="p-5 text-body-md text-clarity-muted">Tela real de uma rede de óticas da Grande São Paulo, com dados de cliente desfocados.</figcaption>
        </figure>
      ) : (
        <div class="card">
          <p class="label-sm mb-4">O que a lista faz</p>
          <ul class="space-y-3 text-body-md text-clarity-off">
            <li class="flex gap-3"><span class="shrink-0 text-clearix-cyan-bright" aria-hidden="true">→</span>Uma lista por dia para a equipe retomar contato.</li>
            <li class="flex gap-3"><span class="shrink-0 text-clearix-cyan-bright" aria-hidden="true">→</span>Não repete quem já foi chamado.</li>
            <li class="flex gap-3"><span class="shrink-0 text-amber-400/80" aria-hidden="true">✕</span><span class="text-clarity-dim">Sem disparo em massa e sem recall por IA.</span></li>
          </ul>
        </div>
      )}
    </div>
  </section>

  <!-- S2 · Espelho da dor -->
  <section class="py-20 md:py-28 border-b border-clarity-off/10">
    <div class="container-grid">
      <div class="max-w-2xl mb-12">
        <p class="label mb-4">Se isso acontece na sua loja</p>
        <h2 class="h-section">O problema não é a equipe. É o dado espalhado.</h2>
      </div>
      <ul class="grid gap-px overflow-hidden rounded-lg border border-clarity-off/10 bg-clarity-off/10 md:grid-cols-2">
        {dores.map((d) => (
          <li class="bg-ink-surface p-6 md:p-8">
            <p class="mb-4 flex gap-3 text-body-md text-clarity-dim"><span class="shrink-0 text-amber-400/80" aria-hidden="true">✕</span>{d.dor}</p>
            <p class="flex gap-3 text-body-md text-clarity-off"><span class="shrink-0 text-clearix-cyan-bright" aria-hidden="true">→</span>{d.resposta}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- S3 · O mecanismo: a vida de uma OS -->
  <section id="como-funciona" class="py-20 md:py-28 bg-ink-deep border-b border-clarity-off/10">
    <div class="container-grid">
      <div class="max-w-2xl mb-10">
        <p class="label mb-4">Como funciona</p>
        <h2 class="h-section">Uma OS, do grau à comissão, sem redigitar nada.</h2>
      </div>

      <div class="mb-14 grid gap-4">
        <div>
          <p class="label-sm mb-3">Hoje, cada etapa num lugar</p>
          <ol class="flex flex-col gap-2 text-body-md text-clarity-muted md:flex-row md:items-center">
            {cadeiaSolta.map((c, i) => (
              <li class="flex items-center gap-2">
                <span class="rounded border border-clarity-off/10 bg-clarity-off/[0.03] px-4 py-2">{c}</span>
                {i < cadeiaSolta.length - 1 && <span class="hidden md:inline" aria-hidden="true">·</span>}
              </li>
            ))}
          </ol>
        </div>
        <p class="font-display text-headline-md text-clarity-off">No Clearix, <span class="text-clearix-cyan-bright">o mesmo pedido corre num fluxo só.</span></p>
      </div>

      <ol class="grid gap-px overflow-hidden rounded-xl border border-clarity-off/10 bg-clarity-off/10 md:grid-cols-2 lg:grid-cols-3">
        {jornadaOS.map((p, i) => (
          <li class="flex flex-col bg-ink-surface p-7">
            <span class="font-mono tabular-nums text-label-md text-clearix-cyan-bright">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 mb-2 font-display text-xl font-semibold text-clarity-off">{p.passo}</h3>
            <p class="mb-6 text-body-md text-clarity-muted">{textosPasso[p.passo]}</p>
            <ul class="mt-auto grid gap-2 border-t border-clarity-off/10 pt-4">
              {p.numeros.map((n) => (
                <li class="flex items-baseline gap-2">
                  <span class="shrink-0 font-mono tabular-nums text-clarity-off">{n.valor}</span>
                  <span class="text-[13px] leading-snug text-clarity-muted">{n.label}</span>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>

      {/* Telas reais aprovadas (folha §7): public/capturas/, dados de cliente, OS, valor, usuário e logotipo desfocados. */}
      <div class="mt-14">
        <p class="label mb-2">Na tela, da operação real</p>
        <p class="mb-8 max-w-2xl text-body-md text-clarity-muted">Telas de uma rede de óticas da Grande São Paulo. Dados de cliente, OS, valores e usuário estão desfocados.</p>

        <div class="grid gap-6 md:grid-cols-2">
          <figure class="shot reveal">
            <picture class="block">
          <source srcset="/capturas/vendas-entrega-bloqueada_desfocado-800.avif 800w, /capturas/vendas-entrega-bloqueada_desfocado.avif 1600w" sizes="(min-width: 768px) 50vw, 100vw" type="image/avif" />
          <source srcset="/capturas/vendas-entrega-bloqueada_desfocado-800.webp 800w, /capturas/vendas-entrega-bloqueada_desfocado.webp 1600w" sizes="(min-width: 768px) 50vw, 100vw" type="image/webp" />
          <img src="/capturas/vendas-entrega-bloqueada_desfocado.png" width="1600" height="746" loading="lazy" decoding="async"
              alt="Lista de entregas pendentes em que os pedidos com saldo em aberto e sem carnê mostram o selo Pagamento Pendente no lugar do botão de entregar" class="block h-auto w-full" />
        </picture>
            <figcaption class="p-5 text-body-md text-clarity-muted"><span class="font-mono tabular-nums text-clearix-cyan-bright">05</span> Entrega: com saldo em aberto e sem carnê, o pedido não sai.</figcaption>
          </figure>
          <figure class="shot reveal">
            <picture class="block">
          <source srcset="/capturas/vendas-baixa-carne-recibo_desfocado-v2-800.avif 800w, /capturas/vendas-baixa-carne-recibo_desfocado-v2.avif 1600w" sizes="(min-width: 768px) 50vw, 100vw" type="image/avif" />
          <source srcset="/capturas/vendas-baixa-carne-recibo_desfocado-v2-800.webp 800w, /capturas/vendas-baixa-carne-recibo_desfocado-v2.webp 1600w" sizes="(min-width: 768px) 50vw, 100vw" type="image/webp" />
          <img src="/capturas/vendas-baixa-carne-recibo_desfocado-v2.png" width="1600" height="692" loading="lazy" decoding="async"
              alt="Lista de parcelas do carnê pagas e pendentes ao lado da segunda via do recibo de parcela paga" class="block h-auto w-full" />
        </picture>
            <figcaption class="p-5 text-body-md text-clarity-muted"><span class="font-mono tabular-nums text-clearix-cyan-bright">06</span> Fechamento: parcela baixada e recibo na hora. É a 2ª via exibida na tela; no uso real vai à impressora.</figcaption>
          </figure>
        </div>
      </div>

      <p class="label-sm mt-10 normal-case tracking-wide text-clarity-muted">Números da operação real, medidos em {medidoEm}.</p>
    </div>
  </section>

  {/* S4 · O momento de valor. Captura real aprovada em 23/09 (06-prints/aprovadas → public/capturas/): custos e fundo desfocados.
      Legenda = frase autorizada da folha única §2; nunca "qualidade". */}
  <section class="py-20 md:py-28 border-b border-clarity-off/10">
    <div class="container-grid">
      <div class="card max-w-4xl">
        <div class="prism-edge mb-6 h-[2px] w-20 rounded-full"></div>
        <p class="label mb-4">O que a gente mostra primeiro na demonstração</p>
        <h2 class="h-section mb-5">A mesma lente, em laboratórios diferentes. Veja preço e prazo lado a lado antes de comprar.</h2>
        <p class="body-lg mb-4">
          Para a lente vendida, o Clearix lista as equivalentes nos laboratórios com que você tem acordo, com o custo e o
          prazo de cada um. <strong class="text-clarity-off">Compara preço e prazo. Quem decide é você.</strong>
        </p>
        <p class="text-body-md text-clarity-muted">Não avaliamos qualidade de laboratório; esse julgamento continua sendo seu.</p>
      </div>

      <figure class="shot reveal mt-10 max-w-5xl">
        <picture class="block">
          <source srcset="/capturas/dcl-comparacao-labs_desfocado-800.avif 800w, /capturas/dcl-comparacao-labs_desfocado.avif 1440w" sizes="(min-width: 1024px) 1024px, 100vw" type="image/avif" />
          <source srcset="/capturas/dcl-comparacao-labs_desfocado-800.webp 800w, /capturas/dcl-comparacao-labs_desfocado.webp 1440w" sizes="(min-width: 1024px) 1024px, 100vw" type="image/webp" />
          <img src="/capturas/dcl-comparacao-labs_desfocado.png" width="1440" height="850" loading="lazy" decoding="async"
            alt="Janela com as 5 melhores opções da mesma lente em três laboratórios, ordenadas por preço e prazo, com o custo de cada uma desfocado" class="block h-auto w-full" />
        </picture>
        <figcaption class="p-5 text-body-md text-clarity-muted">Mostra preço e prazo da mesma lente em cada laboratório; a ordem pesa preço, prazo e a preferência que a própria loja dá a cada fornecedor. Não avalia qualidade nem histórico do laboratório. Tela real de uma rede de óticas da Grande São Paulo, com os custos do acordo desfocados.</figcaption>
      </figure>
    </div>
  </section>

  <!-- S5 · Prova: números do banco -->
  <section id="prova" class="py-20 md:py-28 bg-ink-deep border-b border-clarity-off/10">
    <div class="container-grid">
      <div class="max-w-2xl mb-12">
        <p class="label mb-4">Operação real · medido em {medidoEm}</p>
        <h2 class="h-section mb-5">Números do banco, não de pesquisa.</h2>
        <p class="body-lg">Em vez de logotipos, mostramos o que o sistema registrou numa ótica real, com data.</p>
      </div>
      <ul class="grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-clarity-off/10 bg-clarity-off/10 md:grid-cols-3">
        {provaBanco.map((n, i) => (
          <li class={`bg-ink-surface p-6 ${i === provaBanco.length - 1 ? 'col-span-2 md:col-span-1' : ''}`}>
            <span class="block font-mono tabular-nums text-[clamp(1.6rem,3vw,2.4rem)] leading-none text-clarity-off">{n.valor}</span>
            <span class="mt-3 block text-[13px] leading-snug text-clarity-muted">{n.label}</span>
          </li>
        ))}
      </ul>
      <p class="body-lg mt-10 max-w-3xl">
        Uma rede de óticas da Grande São Paulo opera no Clearix: uma loja vende nele todos os dias e o histórico de outras
        cinco lojas da mesma rede está preservado no mesmo banco.
      </p>
      <p class="label-sm mt-4 max-w-3xl normal-case tracking-wide text-clarity-muted">
        OS de 2020 a 2025 vieram do sistema anterior: é histórico preservado, não processado pelo Clearix. Números do banco
        de produção, sem dado pessoal, medidos em {medidoEm}.
      </p>
    </div>
  </section>

  {/* S6 · Quem está por trás (D1: assinado pela DIGIAI, sem pessoa e sem foto) */}
  <section class="py-20 md:py-28 border-b border-clarity-off/10">
    <div class="container-grid grid gap-8 md:grid-cols-12 md:items-start">
      <div class="md:col-span-5">
        <p class="label mb-4">Feito por quem opera ótica</p>
        <h2 class="h-section">Construído dentro do balcão, não numa sala de reunião.</h2>
      </div>
      <div class="md:col-span-7">
        <p class="body-lg">
          O Clearix é da DIGIAI Ótica e Tecnologia. Cada tela nasceu de um problema real de balcão: OS atrasada, carnê
          perdido, caixa que não fecha. Primeiro resolvemos na nossa operação; depois oferecemos a outras óticas.
        </p>
        <p class="mt-6 font-mono text-label-md uppercase tracking-widest text-clearix-cyan-bright">DIGIAI</p>
      </div>
    </div>
  </section>

  <!-- S7 · Módulos em uso -->
  <section class="py-20 md:py-28 bg-ink-deep border-b border-clarity-off/10">
    <div class="container-grid">
      <div class="max-w-2xl mb-12">
        <p class="label mb-4">O que vem no sistema</p>
        <h2 class="h-section mb-5">Tudo o que a loja usa num dia, com um login só.</h2>
        <p class="body-lg">Módulos especializados, não puxadinhos. Um acesso abre o que cada pessoa pode ver, por loja e por papel.</p>
      </div>
      <div class="grid gap-px overflow-hidden rounded-lg border border-clarity-off/10 bg-clarity-off/10 md:grid-cols-2 lg:grid-cols-4">
        {jornadas.map((j) => (
          <div class="bg-ink-surface p-6">
            <p class="mb-5 font-mono text-label-md uppercase tracking-widest text-clearix-cyan">{j.titulo}</p>
            <ul class="space-y-5">
              {apps.filter((a) => a.jornada === j.key).map((a) => (
                <li>
                  <span class="flex items-center gap-2">
                    <span class="h-2 w-2 shrink-0 rounded-full" style={`background:${a.cor}`}></span>
                    <span class="font-display font-semibold text-clarity-off">{a.nome}</span>
                  </span>
                  <span class="mt-1 block text-[13px] leading-snug text-clarity-muted">
                    {a.tagline}
                    {a.slug === 'clinics' && <> <span class="font-mono tabular-nums text-clarity-dim">{receitas.valor}</span> {receitas.label}.</>}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <a href="/ecossistema" class="mt-8 inline-block font-mono text-label-md uppercase tracking-wider text-clearix-cyan transition-colors hover:text-clearix-cyan-soft">Ver cada módulo →</a>
    </div>
  </section>

  {/* Rótulo — depois de dor, produto na tela e prova; logo acima do preço de S8 (Geral, 23/09; o preço não abre a página, 21/09) */}
  <Rotulo />

  <!-- S8 · Oferta: como começa -->
  <section id="como-comecar" class="py-20 md:py-28 border-b border-clarity-off/10">
    <div class="container-grid">
      <div class="max-w-2xl mb-12">
        <p class="label mb-4">Como começar</p>
        <h2 class="h-section">Primeiro você vê. Depois decide.</h2>
      </div>
      <ol class="grid gap-px overflow-hidden rounded-xl border border-clarity-off/10 bg-clarity-off/10 md:grid-cols-3">
        {fases.map((f, i) => (
          <li class="bg-ink-surface p-7 md:p-8">
            <span class="font-mono text-label-md text-clearix-cyan-bright">Fase {String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 mb-2 font-display text-xl font-semibold text-clarity-off">{f.t}</h3>
            <p class="text-body-md text-clarity-muted">{f.d}</p>
          </li>
        ))}
      </ol>

      {/* Preço aqui, não no Rótulo (decisão do dono, 21/09): depois de dor (S2) e prova (S5), o preço ancora em
          valor, não em custo. Âncora do Rótulo ("Preço claro, sem letra miúda ↓") aponta para este bloco. */}
      <div class="reveal mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-clarity-off/10 bg-clarity-off/10 sm:grid-cols-4">
        {planos.map((p) => (
          <div class="bg-ink-surface p-5">
            <span class="block font-display font-semibold text-clarity-off">{p.nome}</span>
            <span class="mt-1 block whitespace-nowrap"><span class="font-mono tabular-nums text-xl text-clarity-off">{p.preco}</span><span class="text-body-md text-clarity-muted">{p.precoNota ?? ''}</span></span>
          </div>
        ))}
      </div>
      <p class="mt-3 text-[13px] leading-snug text-clarity-muted">Preço público, sem letra miúda. Sem período grátis. O piloto é pago e combinado depois da demonstração.</p>

      <div class="mt-8">
        <div class="flex flex-wrap items-center gap-x-8 gap-y-4">
          <a href="/contato" class="btn-primary" data-cta="oferta">{CTA}</a>
          <a href="/planos" class="inline-flex min-h-[44px] items-center font-mono text-label-md uppercase tracking-wider text-clearix-cyan transition-colors hover:text-clearix-cyan-soft">Ver os planos em detalhe →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- S9 · Perguntas (mesma lista do JSON-LD FAQPage) -->
  <section class="py-20 md:py-28 border-b border-clarity-off/10">
    <div class="container-grid grid gap-8 md:grid-cols-12 md:gap-16">
      <div class="md:col-span-4">
        <p class="label mb-4">Dúvidas</p>
        <h2 class="h-sub">Perguntas de quem está pensando em trocar de sistema</h2>
      </div>
      <div class="md:col-span-8">
        <div class="border-t border-clarity-off/10">
          {faq.map((f) => (
            <details class="group border-b border-clarity-off/10">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clearix-cyan-bright">
                <span class="font-display text-lg font-semibold md:text-xl">{f.q}</span>
                <span class="font-mono text-2xl leading-none text-clearix-cyan transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="unfold3d max-w-2xl pb-6 text-body-md text-clarity-muted">{f.a}</p>
            </details>
          ))}
        </div>
        <a href="/contato" class="mt-8 inline-block font-mono text-label-md uppercase tracking-wider text-clearix-cyan transition-colors hover:text-clearix-cyan-soft" data-cta="faq">{CTA} →</a>
      </div>
    </div>
  </section>

  <!-- S10 · CTA final -->
  <CtaFinal prova />
</BaseLayout>
