---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { apps, jornadas } from '../data/apps';

// UTM explícita: o clearix-attrib.js só carimba links que ainda não têm origem
// própria, então esta marcação sobrevive.
const CALC = 'https://calc.clearix.app.br/?utm_source=clearix&utm_medium=landing&utm_campaign=ecossistema';
---

<BaseLayout
  title="Módulos do Clearix — o sistema da ótica, de orçamento a entrega"
  description="Vendas, pacientes e receitas, laboratório, lentes, financeiro, estoque, equipe, painel do dono, WhatsApp da loja e portal do paciente. Módulos em uso numa ótica real, com um login só."
>
  <!-- Hero -->
  <section data-lux class="lux-cyan relative overflow-hidden grid-bg pt-32 pb-16 md:pt-40 md:pb-20 border-b border-clarity-off/10">
    <div class="lux-glow"></div>
    <div class="container-grid max-w-3xl anim-fade-in relative z-10">
      <p class="label mb-6">O que vem no sistema</p>
      <h1 class="h-display mb-6">Módulos especializados, <span class="text-clearix-cyan italic">não puxadinhos</span>.</h1>
      <p class="body-lg max-w-2xl">
        Os módulos do Clearix usam os mesmos dados: a venda gera a OS do laboratório e baixa a armação do estoque, a
        conta do laboratório nasce da OS no financeiro e a comissão sai da venda entregue. Aqui só aparece o que está em
        uso numa ótica real.
      </p>
    </div>
  </section>

  <!-- Apps por jornada -->
  {jornadas.map((j, idx) => (
    <section class={`py-16 md:py-24 border-b border-clarity-off/10 ${idx % 2 === 1 ? 'bg-ink-deep' : ''}`}>
      <div class="container-grid">
        <div class="max-w-2xl mb-10">
          <p class="label mb-3">{j.titulo}</p>
          <h2 class="h-sub">{j.desc}</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-clarity-off/10 border border-clarity-off/10 rounded-lg overflow-hidden focus3d">
          {apps.filter((a) => a.jornada === j.key).map((a) => (
            <div class="bg-ink-surface p-6 flex gap-4 transition-shadow hover:shadow-[0_0_40px_-16px_#06B6D4]">
              <span class="mt-1 w-3 h-3 rounded-full shrink-0" style={`background:${a.cor}`}></span>
              <div>
                <h3 class="font-display font-semibold text-xl text-clarity-off mb-1">{a.nome}</h3>
                <p class="text-clarity-muted text-body-md">{a.tagline}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!--
    Isca recíproca. Quem está pesquisando ecossistema ainda não vai agendar
    demo, mas usa uma ferramenta útil hoje — e é a calculadora que ele
    compartilha com colega de profissão, que é o que gira o boca-a-boca.
    Fica ANTES do CTA final de propósito: é o degrau de baixo compromisso
    para quem não vai clicar em "agendar".
  -->
  <section class="py-16 md:py-20 border-b border-clarity-off/10">
    <div class="container-grid">
      <div class="card flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
        <div class="max-w-xl">
          <p class="label mb-3">Ferramenta aberta, sem cadastro</p>
          <h2 class="h-sub mb-3">
            Calculadora de grau <span class="text-clearix-cyan italic">para usar hoje</span>.
          </h2>
          <p class="text-clarity-muted text-body-md">
            Transposição, distância vértice, equivalente esférico e mais — as contas do
            balcão, feitas certo. Funciona offline no celular. É uma amostra de como o
            Clearix trata o rigor óptico; não pede login e não expira.
          </p>
        </div>
        <a href={CALC} target="_blank" rel="noopener" class="btn-primary shrink-0 self-start md:self-auto">
          Abrir a calculadora →
        </a>
      </div>
    </div>
  </section>

  {/* A nota de "isolamento de dados por loja" saiu: afirmação de segurança só depois do teste de isolamento (D6). */}

  <CtaFinal titulo="Quer ver os módulos trabalhando juntos?" texto="Em 20 minutos de demonstração, você acompanha uma OS da receita à entrega, passando por cada módulo." />
</BaseLayout>
