---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaFinal from '../components/CtaFinal.astro';

// Perfis de comprador. Cada "No Clearix" cita só módulo com uso medido (Cockpit/comercial/inventario-…-2026-09-14.md).
// Sem composição de plano aqui: lojas e módulos por plano esperam a D5 do dono.
const personas = [
  { tag: 'Ótica solo', titulo: 'Você toca tudo sozinho', dor: 'Venda, carnê e caixa espalhados entre caderno, planilha e um sistema antigo.', solucao: 'Orçamento, venda, carnê e caixa no mesmo fluxo, com a receita ligada à venda.' },
  { tag: '2 a 4 lojas', titulo: 'Você abriu a segunda (e a terceira)', dor: 'Cada loja anota do seu jeito, e você só descobre o atraso quando o cliente liga.', solucao: 'Cada OS acompanhada por etapa, com alerta de atraso e o painel do dono mostrando o dia.' },
  { tag: 'Rede', titulo: 'Você responde por várias lojas', dor: 'Comissão, estoque e financeiro fechados em planilhas diferentes por loja.', solucao: 'Um login por pessoa, com acesso por loja e por papel, e comissão calculada da venda entregue.' },
  { tag: 'Ótica com consultório', titulo: 'Você atende e vende', dor: 'A receita fica numa pasta e a venda em outro lugar.', solucao: 'Ficha do paciente e receita ligadas à venda, sem redigitar.' },
];
---

<BaseLayout
  title="Para quem é o Clearix — da ótica solo à rede"
  description="Da ótica que vende sozinha à rede com várias lojas. Veja o que o Clearix resolve em cada estágio, com módulos em uso numa ótica real."
>
  <!-- Hero -->
  <section data-lux class="lux-cyan relative overflow-hidden grid-bg pt-32 pb-16 md:pt-40 md:pb-20 border-b border-clarity-off/10">
    <div class="lux-glow"></div>
    <div class="container-grid max-w-3xl anim-fade-in relative z-10">
      <p class="label mb-6">Para quem é</p>
      <h1 class="h-display mb-6">Da ótica solo <span class="text-clearix-cyan-bright italic">à rede</span>.</h1>
      <p class="body-lg max-w-2xl">
        O Clearix nasceu dentro de uma ótica de verdade. Na demonstração, a gente olha o tamanho e o jeito da sua loja
        antes de indicar por onde começar.
      </p>
    </div>
  </section>

  <!-- Personas -->
  <section class="py-16 md:py-24">
    <div class="container-grid">
      <div class="grid gap-px bg-clarity-off/10 border border-clarity-off/10 rounded-lg overflow-hidden reveal">
        {personas.map((p) => (
          <div class="bg-ink-surface p-7 md:p-9 grid md:grid-cols-12 gap-4 md:gap-8 items-start">
            <div class="md:col-span-3">
              <span class="font-mono text-label-sm uppercase tracking-widest text-clearix-cyan">{p.tag}</span>
              <h2 class="font-display font-semibold text-xl text-clarity-off mt-2">{p.titulo}</h2>
            </div>
            <div class="md:col-span-5">
              <p class="label-sm text-clarity-muted mb-2">A dor</p>
              <p class="text-clarity-dim text-body-md">{p.dor}</p>
            </div>
            <div class="md:col-span-4">
              <p class="label-sm text-clearix-cyan mb-2">No Clearix</p>
              <p class="text-clarity-dim text-body-md">{p.solucao}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaFinal titulo="Não sabe por onde começar?" texto="Conte o tamanho da sua operação e a gente indica o ponto de partida certo, sem empurrar plano." />
</BaseLayout>
