---
import BaseLayout from '../layouts/BaseLayout.astro';
import { linkWhatsapp, whatsapp, email, empresa, HUB } from '../data/contato';

const WHATS = linkWhatsapp('contato');

const campo = 'bg-ink-surface border border-clarity-off/15 rounded px-4 py-3 text-clarity-off placeholder:text-clarity-muted/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clearix-cyan';
const rotulo = 'font-mono text-label-sm uppercase tracking-wider text-clarity-muted';

const proximos = [
  'A gente entra em contato em horário comercial, pelo WhatsApp ou e-mail que você deixou.',
  'Marcamos 20 minutos no melhor horário para você.',
  'Na demonstração, olhamos a sua loja antes de falar de preço.',
];
---

<BaseLayout
  title="Agende 20 minutos de demonstração do Clearix"
  description="Conte como a sua ótica trabalha hoje. Na demonstração assistida, mostramos o Clearix da receita à entrega e olhamos a sua loja antes de falar de preço."
>
  <section data-lux class="lux-cyan relative overflow-hidden grid-bg pt-32 pb-16 md:pt-40 md:pb-20 border-b border-clarity-off/10">
    <div class="lux-glow"></div>
    <div class="container-grid max-w-3xl anim-fade-in relative z-10">
      <p class="label mb-6">Contato</p>
      <h1 class="h-display mb-6">Veja o Clearix <span class="text-clearix-cyan italic">na sua ótica</span>.</h1>
      <p class="body-lg max-w-2xl">
        Conte como a sua operação funciona hoje. Na demonstração, mostramos o fluxo da receita à entrega e dizemos com
        franqueza se o Clearix atende o seu cenário.
      </p>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="container-grid grid md:grid-cols-12 gap-10 md:gap-16">
      <!-- Formulário — POSTa na edge fn lead-capture (banco digiai, marketing.landing_leads) -->
      <div class="md:col-span-7">
        <form id="form-demo" method="POST" class="grid gap-5">
          <p class="hidden" aria-hidden="true"><label>Não preencha: <input name="website" tabindex="-1" autocomplete="off" /></label></p>

          <label class="grid gap-2">
            <span class={rotulo}>Seu nome</span>
            <input type="text" name="nome" required autocomplete="name" class={campo} placeholder="Como podemos te chamar?" />
          </label>

          <div class="grid md:grid-cols-2 gap-5">
            <label class="grid gap-2">
              <span class={rotulo}>WhatsApp</span>
              <input type="tel" name="whatsapp" required autocomplete="tel" class={campo} placeholder="(11) 90000-0000" />
            </label>
            <label class="grid gap-2">
              <span class={rotulo}>E-mail <span class="normal-case tracking-normal text-clarity-muted/60">(opcional)</span></span>
              <input type="email" name="email" autocomplete="email" class={campo} placeholder="voce@suaotica.com.br" />
            </label>
          </div>

          <div class="grid md:grid-cols-2 gap-5">
            <label class="grid gap-2">
              <span class={rotulo}>Você é</span>
              <select name="funcao" required class={campo}>
                <option value="">Selecione…</option>
                <option value="dono">Dono(a) ou sócio(a)</option>
                <option value="gerente">Gerente</option>
                <option value="outro">Outro</option>
              </select>
            </label>
            <label class="grid gap-2">
              <span class={rotulo}>Quantas lojas?</span>
              <select name="lojas" required class={campo}>
                <option value="">Selecione…</option>
                <option value="1">1 loja</option>
                <option value="2-4">2 a 4 lojas</option>
                <option value="5+">5 ou mais</option>
              </select>
            </label>
          </div>

          <label class="grid gap-2">
            <span class={rotulo}>Sistema que usa hoje</span>
            <input type="text" name="sistema" required class={campo} placeholder="Nome do sistema, ou “planilha”" />
          </label>

          <label class="grid gap-2">
            <span class={rotulo}>O que mais atrapalha hoje <span class="normal-case tracking-normal text-clarity-muted/60">(opcional)</span></span>
            <textarea name="problema" rows="3" class={campo} placeholder="Ex.: OS atrasada, carnê no caderno, caixa que não bate…"></textarea>
          </label>

          <button type="submit" class="btn-primary justify-self-start" data-submit data-cta="contato_submit">Solicitar demonstração</button>
          <p class="label-sm normal-case tracking-wide text-clarity-muted/60" data-consent-text>
            Seus dados são usados só para o contato comercial, conforme a LGPD.
          </p>

          <p data-form-ok hidden role="status" class="rounded-lg border border-clearix-cyan/30 bg-clearix-navy/20 px-4 py-3 text-body-md text-clarity-off">
            <span class="text-clearix-cyan-bright">Recebido.</span> A gente entra em contato em horário comercial, pelo WhatsApp ou e-mail que você deixou.
          </p>
          <p data-form-erro hidden role="alert" class="rounded-lg border border-amber-400/30 bg-amber-400/5 px-4 py-3 text-body-md text-clarity-off">
            Sua conexão está fora de foco. Tente de novo{WHATS ? ' ou ' : '.'}
            {WHATS && <a href={WHATS} target="_blank" rel="noopener" class="text-clearix-cyan-bright underline">fale pelo WhatsApp</a>}{WHATS && '.'}
          </p>
        </form>

        <script is:inline>
          (function () {
            var form = document.getElementById('form-demo');
            if (!form || form.dataset.init) return; form.dataset.init = '1';
            var btn = form.querySelector('[data-submit]');
            var ok = form.querySelector('[data-form-ok]');
            var erro = form.querySelector('[data-form-erro]');
            form.addEventListener('submit', async function (e) {
              e.preventDefault();
              ok.hidden = true; erro.hidden = true;
              btn.disabled = true; var label = btn.textContent; btn.textContent = 'Enviando…';
              var fd = new FormData(form);
              try {
                /*
                 * A atribuição vem do clearix-attrib.js, não de location.search.
                 * Quem chega pela calc cai em "/" com a UTM, navega, e só depois
                 * converte aqui — nesse ponto a query string já sumiu. O
                 * fallback existe só para o caso do script não ter carregado.
                 */
                var attrib = window.clearixAttrib;
                var params = new URLSearchParams(location.search);
                var u = attrib ? attrib.utms() : {};
                function utm(k) { return u[k] || params.get(k) || ''; }

                // lead-capture não tem coluna para função/sistema/problema: vão em notes, legíveis por gente.
                var notes = 'Lojas: ' + (fd.get('lojas') || '?') +
                  ' | Função: ' + (fd.get('funcao') || '?') +
                  ' | Sistema atual: ' + (fd.get('sistema') || '?') +
                  (fd.get('problema') ? ' | Principal problema: ' + fd.get('problema') : '');

                var res = await fetch('https://hswyopqvnolqpmprqvzh.supabase.co/functions/v1/lead-capture', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({
                    product: 'clearix',
                    name: fd.get('nome') || '',
                    whatsapp: fd.get('whatsapp') || '',
                    email: fd.get('email') || '',
                    notes: notes.slice(0, 1000),
                    source_url: location.href.slice(0, 500),
                    // Liga este lead à sessão anônima que navegou o site (e, se
                    // veio da calc, ao utm_content que ela mandou). É o gancho
                    // da camada 2 de indicação.
                    session_id: attrib ? attrib.sessionId() : null,
                    utm_source: utm('utm_source'),
                    utm_medium: utm('utm_medium'),
                    utm_campaign: utm('utm_campaign'),
                    utm_content: utm('utm_content'),
                    utm_term: utm('utm_term'),
                    consent_text: (form.querySelector('[data-consent-text]') || {}).textContent?.trim() || '',
                    website: fd.get('website') || '',
                  }),
                });
                var body = await res.json().catch(function () { return {}; });
                if (res.ok && body.ok) {
                  ok.hidden = false; form.reset();
                  if (attrib) attrib.track('click_checkout', { destino: 'contato', cta_id: 'contato_submit', texto: 'lead enviado' });
                }
                else { erro.hidden = false; }
              } catch (_) { erro.hidden = false; }
              btn.disabled = false; btn.textContent = label;
            });
          })();
        </script>
      </div>

      <div class="md:col-span-5 grid gap-6 content-start">
        <div class="card">
          <p class="label mb-5">O que acontece agora?</p>
          <ol class="space-y-4">
            {proximos.map((p, i) => (
              <li class="flex gap-3 text-body-md text-clarity-dim">
                <span class="font-mono tabular-nums text-clearix-cyan-bright">{String(i + 1).padStart(2, '0')}</span>{p}
              </li>
            ))}
          </ol>
        </div>

        <div class="card">
          <p class="label mb-4">Prefere falar direto?</p>
          <ul class="space-y-5 text-body-md">
            {WHATS && whatsapp && (
              <li>
                <a href={WHATS} target="_blank" rel="noopener" data-cta="contato_whatsapp" class="flex flex-col hover:text-clearix-cyan transition-colors">
                  <span class={rotulo}>WhatsApp</span>
                  <span class="font-mono tabular-nums text-clarity-off">{whatsapp.exibicao}</span>
                </a>
              </li>
            )}
            <li>
              <a href={`mailto:${email}`} class="flex flex-col hover:text-clearix-cyan transition-colors">
                <span class={rotulo}>E-mail</span>
                <span class="font-mono text-clarity-off">{email}</span>
              </a>
            </li>
            <li>
              <a href={HUB} target="_blank" rel="noopener" class="flex flex-col hover:text-clearix-cyan transition-colors">
                <span class={rotulo}>Já sou cliente</span>
                <span class="font-mono text-clarity-off">Entrar no Hub →</span>
              </a>
            </li>
          </ul>
          <div class="divider mt-6 pt-6 text-clarity-muted text-body-md">
            <p>{empresa.cidade} · Brasil</p>
            <p class="font-mono text-label-sm mt-1">Seg a Sex · horário comercial</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
