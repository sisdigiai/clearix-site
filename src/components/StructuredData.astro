---
// JSON-LD para SEO + GEO/AEO (buscadores e crawlers de IA).
// Schemas: SoftwareApplication (Clearix) + Organization (DIGIAI) + WebSite + ItemList (módulos) + FAQPage.
// Dados canônicos — não inventar. Módulos, FAQ, planos e contato vêm de src/data.
import { apps } from '../data/apps';
import { planos } from '../data/planos';
import { faq } from '../data/landing';
import { whatsapp, email, empresa, endereco } from '../data/contato';

const SITE = 'https://clearix.app.br';
const DIGIAI_LOGO = 'https://hswyopqvnolqpmprqvzh.supabase.co/storage/v1/object/public/digiai-brand/logo/horizontal_dark.png';

const precoNumerico = (preco: string) => preco.replace(/[^\d,]/g, '').replace(',', '.');

// 1) Clearix como software. Composição dos planos (lojas, módulos) fica fora até a D5.
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': `${SITE}/#clearix`,
  name: 'Clearix',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: 'Sistema para óticas: venda, carnê, laboratório, WhatsApp da loja, estoque, financeiro e painel do dono no mesmo sistema, com um login só.',
  url: SITE,
  image: `${SITE}/og-clearix.png`,
  inLanguage: 'pt-BR',
  publisher: { '@id': `${SITE}/#organization` },
  offers: planos
    .filter((p) => /\d/.test(p.preco))
    .map((p) => ({ '@type': 'Offer', name: p.nome, price: precoNumerico(p.preco), priceCurrency: 'BRL', availability: 'https://schema.org/InStock' })),
};

// 2) DIGIAI — empresa-mãe (publisher). Telefone só com D2; endereço completo só com D3b.
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE}/#organization`,
  name: 'DIGIAI',
  alternateName: empresa.razaoSocial,
  legalName: empresa.razaoSocial,
  url: 'https://digiai.app.br',
  logo: { '@type': 'ImageObject', url: DIGIAI_LOGO, width: 1200, height: 400 },
  image: DIGIAI_LOGO,
  email,
  ...(whatsapp ? { telephone: `+${whatsapp.numero}` } : {}),
  description: 'Empresa de tecnologia criadora do Clearix, o sistema para óticas feito dentro de uma ótica.',
  foundingDate: '2026-05-21',
  taxID: empresa.cnpj,
  vatID: empresa.cnpj,
  numberOfEmployees: { '@type': 'QuantitativeValue', minValue: 1, maxValue: 5 },
  knowsAbout: [
    'Gestão de óticas',
    'Software para óticas',
    'Laboratório óptico',
    'Carnê e crediário de ótica',
    'Brasil',
  ],
  address: endereco.confirmado
    ? {
        '@type': 'PostalAddress',
        streetAddress: `${endereco.logradouro}, ${endereco.bairro}`,
        addressLocality: endereco.cidade,
        addressRegion: endereco.uf,
        postalCode: endereco.cep,
        addressCountry: 'BR',
      }
    : { '@type': 'PostalAddress', addressLocality: endereco.cidade, addressRegion: endereco.uf, addressCountry: 'BR' },
  contactPoint: {
    '@type': 'ContactPoint',
    ...(whatsapp ? { telephone: `+${whatsapp.numero}` } : {}),
    email,
    contactType: 'customer service',
    areaServed: 'BR',
    availableLanguage: ['Portuguese', 'pt-BR'],
  },
  sameAs: [
    'https://instagram.com/_digiai',
    'https://facebook.com/61586695274933',
    'https://tiktok.com/@sisdigiai',
    'https://youtube.com/@SisDigiai',
    'https://linkedin.com/company/digiai',
    'https://github.com/sisdigiai',
  ],
};

// 3) WebSite (entidade canônica do site)
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE}/#website`,
  url: SITE,
  name: 'Clearix',
  description: 'Sistema para óticas, de orçamento a entrega, feito dentro de uma ótica.',
  inLanguage: 'pt-BR',
  publisher: { '@id': `${SITE}/#organization` },
};

// 4) ItemList dos módulos em uso (bom para GEO — descreve o sistema aos LLMs)
const appsSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': `${SITE}/#modulos`,
  name: 'Módulos do Clearix',
  numberOfItems: apps.length,
  itemListElement: apps.map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'SoftwareApplication',
      name: `Clearix ${a.nome}`,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      description: a.tagline,
      isPartOf: { '@id': `${SITE}/#clearix` },
      publisher: { '@id': `${SITE}/#organization` },
    },
  })),
};

// 5) FAQ — exatamente a lista da home
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${SITE}/#faq`,
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(appsSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
