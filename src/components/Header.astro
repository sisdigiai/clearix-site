---
import Logo from './Logo.astro';
import { CTA } from '../data/landing';
import { HUB } from '../data/contato';

const nav = [
  { label: 'Ecossistema', href: '/ecossistema' },
  { label: 'Planos', href: '/planos' },
  { label: 'Para quem', href: '/para-quem' },
  { label: 'Contato', href: '/contato' },
];

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href;
---

<header class="fixed top-0 left-0 right-0 z-50">
  {/* Faixa de posicionamento: sem número e sem oferta com prazo; só quem somos e o CTA único */}
  <a href="/contato" data-cta="faixa_topo" class="group block bg-ink-deep/95 backdrop-blur-sm border-b border-clarity-off/10 text-center py-2 px-4 hover:bg-ink-surface/70 transition-colors">
    <span class="inline-flex flex-wrap items-center justify-center gap-x-3 gap-y-1">
      <span class="hidden sm:inline-flex items-center gap-2 font-mono text-label-sm uppercase tracking-widest text-clarity-muted/90">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-clearix-cyan-bright"></span>
        Sistema para óticas · feito dentro de uma ótica
      </span>
      <span class="hidden sm:inline text-clarity-muted/25" aria-hidden="true">|</span>
      <span class="inline-flex items-center gap-1.5 text-[12.5px] font-medium text-clearix-cyan-bright group-hover:text-clearix-cyan-soft transition-colors">
        {CTA}
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
      </span>
    </span>
  </a>

  <div class="bg-ink-base/90 backdrop-blur-sm border-b border-clarity-off/10">
  <div class="container-grid flex items-center justify-between h-16">
    <a href="/" aria-label="Clearix — início">
      <Logo />
    </a>

    <nav class="hidden md:flex items-center gap-8 font-mono text-label-md uppercase tracking-wider">
      {nav.map((n) => (
        <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined} class={`transition-colors ${isActive(n.href) ? 'text-clearix-cyan' : 'text-clarity-muted hover:text-clarity-off'}`}>{n.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a href={HUB} target="_blank" rel="noopener" data-cta="header_entrar" class="btn-outline text-label-sm py-2 px-4" aria-label="Entrar no Clearix Hub">Entrar →</a>

      <details class="md:hidden relative">
        <summary class="list-none cursor-pointer font-mono text-label-sm uppercase tracking-wider text-clarity-muted px-2 py-2 select-none">Menu</summary>
        <nav class="absolute right-0 top-full mt-2 w-64 bg-ink-surface border border-clarity-off/10 rounded-lg p-4 flex flex-col gap-3 font-mono text-label-md uppercase tracking-wider">
          {nav.map((n) => <a href={n.href} class="text-clarity-muted hover:text-clarity-off">{n.label}</a>)}
        </nav>
      </details>
    </div>
  </div>
  </div>
</header>
